{
  "name": "Telegram Explorer",
  "short_name": "TG Explorer",
  "description": "Search and discover public Telegram channels and groups — browse them like Instagram Explore, filter by topic and language, and read the posts.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0088cc",
  "orientation": "any",
  "categories": [
    "social",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "docs/mobile.png",
      "sizes": "412x823",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Explore grid on a phone"
    },
    {
      "src": "docs/grid.png",
      "sizes": "1280x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Explore grid"
    },
    {
      "src": "docs/channel.png",
      "sizes": "1280x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "A channel profile with the activity chart"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "url": "./?action=search",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "url": "./?action=explore",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "id": "./",
  "prefer_related_applications": false,
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ]
