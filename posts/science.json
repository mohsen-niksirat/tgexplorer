[{"id":"4519","date":"2026-11-10T20:27:29+00:00","text":"","image":"","video":"","hasVideo":false},{"id":"4518","date":"2026-11-10T16:18:51+00:00","text":"More than 2,000 underwater AI-powered robots armed with lasers have been deployed at salmon farms to combat sea lice. Developed by Norwegian company Stingray, these devices protect around 50 million salmon and trout from potentially deadly parasites — 24/7. Traditional delousing methods, which involve hot water or high-pressure water jets, can seriously injure fish. According to Norway’s Fish Health Report, such treatments are a leading cause of death among adult farmed salmon. Stingray’s robots use cameras and AI to detect parasites on swimming fish, then eliminate them with a green laser from up to 2 meters away — without damaging the fish’s scales. 🐟 AI-powered lasers are now protecting fish from parasites. Welcome to the future of aquaculture. @science","image":"https://cdn4.telesco.pe/file/UzA7quiHONaZp88cGhxiJSyeTu3oJ5Dtb6ugywkbHqf6MmPNP6EmCSLfpsIUO6w_jt-MCRTNLUXAyiQz7YuZWccKpxv4NB4nG1LKibDCnaCUq-xoieLgu9ueYAU0dAuX_8tzPTHYq55-c0YSvGQHegCq41XJBrti4_E-SbItnycZ-DhyVhrnZMScgMW0ljymgg-VfEvfm-o0yZkdl_9zTi4ALAscj5X9N5W2EOwGhE6a5gt8KPjxuHtlssRniqA_0JTIDhAmLBuigPZNxHZbAXi7LfYfuY-6SSHN_rtKVJ7DTJVZm-pbGov7uD1HT7DmUudPRTkakv1dylSfVKRrVg","video":"https://cdn4.telesco.pe/file/59c9917579.mp4?token=NnrzADx1Qzmg4i-v0pKAT_qDSctZ7K4gd9EGIP8bzGFGHOkhyPtlUZC9BbRXGn4ca34qY6oVg3cPciHR2Bm8WXVu32f5W2bXsSZPt9CoDPEFRtqA4tM1hS4UB6STOjy2Bp1G2izwqKxprCcGzYeWA7Dfl0_LmkD1VTVfziPnf5Pc6atJ9WmCMBmMtRU0EccbwMi4-ssHEuwbMf0C0wOJmGzAvANK6f7FFXzrttwlvefCGWg_k4cTIVCMNuQOluieitMVqhhhkBYI9v2DCUaVVoBJVxwB3_v5SdZWJtnUxME1PVdy3lLvBLPuvgKkANWPuF6mpVre7eEBRJafqAeWiQ","hasVideo":true},{"id":"4517","date":"2026-11-10T13:53:03+00:00","text":"","image":"","video":"","hasVideo":false},{"id":"4516","date":"2026-11-10T11:37:49+00:00","text":"","image":"","video":"","hasVideo":false},{"id":"4515","date":"2026-11-10T07:19:00+00:00","text":"","image":"","video":""