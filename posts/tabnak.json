adhit.com #HiNext2026 #نوآوری_باز #هوش_مصنوعی_در_سلامت #سندباکس_تخصصی #معاونت_علمی #بیمه_سلامت &lrm; ✅ @Tabnak","image":"https://cdn4.telesco.pe/file/pbfEDu65GIas1bEisrxP6YFJycQqfdb5dCaOpttabs38W8vU437iBious8Xqd8ZUUdLdWpaauwnTsdZawdGtn6Rl6uHBNzwv3LEh6yN8KqFth7m0cYecHIY_8HvEp6Br8kWkXhtiePWNOhcj74y29OZbVCTkP6_jNlUGfABR_d1HK085ImyhrVyK-1ApI3RLGNPVbzvuVjpuEPsJXx8VDQ1UaQKfCnwQa-w4uyrnXen1SUtQFwawmNwipbWb952U4-iILvrOhP1C2i3NbRueyX40_zH5dydfy2yast6_ZpRlhihhZ_HSGRBjPBIut0tNbzMgJ7F-l_8wrUmMDG_8fQ","video":"","hasVideo":false},{"id":"247028","date":"2026-10-31T19:00:15+00:00","text":"&rlm; ✅ دبیر شورای‌عالی امنیت ملی هشدار داد که در صورت بروز مسئله‌ای برای ایران، تمام دنیا متضرر خواهند شد. این‌طور نیست که مسئله‌ای برای ایران پیش بیاید و فقط ایران ضرر کند؛ همۀ دنیا ضرر خواهند کرد. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247027","date":"2026-10-31T19:00:14+00:00","text":"&rlm; ✅ دبیر شورای‌عالی امنیت ملی اعلام کرد پاسخ آمریکا به شروط ایران قانع‌کننده نبوده است. وی تاکید کرد آمریکا در پاسخ خود مسائلی را مطرح کرده که باید در آینده درباره آن‌ها گفتگو شود. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247026","date":"2026-10-31T19:00:14+00:00","text":"&rlm; ✅ دبیر شورای‌عالی امنیت ملی اعلام کرد در نشست چهارجانبه تهران درباره پیمان مکه و مسئله یمن صحبتی نشد. به گفته وی، محور اصلی این گفتگوها بر چگونگی ترتیبات آینده منطقه متمرکز بوده است. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247025","date":"2026-10-31T19:00:13+00:00","text":"&rlm; ✅ دبیر شورای‌عالی امنیت ملی اعلام کرد شروط ۷گانه‌ای برای آمریکا ارسال شده و تا زمانی که این شروط عملی نشود، مذاکره‌ای در کار نخواهد بود. وی تأکید کرد چارچوب و شیوه این شروط با اسلام‌آباد متفاوت است. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247024","date":"2026-10-31T19:00:12+00:00","text":"&rlm; ✅ دبیر شورای‌عالی امنیت ملی تاکید کرد که اگر ترامپ و آمریکا تنبیه نشوند، کشورهای دیگر تصور می‌کنند حمله به ایران بدون هزینه خواهد بود. وی هشدار داد در صورت عدم احیای حقوق ایران، سایر کشورها نیز جرئت حمله به ایران را پیدا خواهند کرد. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247023","date":"2026-10-31T18:55:58+00:00","text":"&rlm; ✅ «روایت وطن» یا ترنس‌نوازیِ انجمن؟! واقعا عجیب است. انجمن سینمای جوانی که پویش ویژه «وطن به روایت من» برگزار می‌کند، در عرصه واقعی تولید، به آثار حامیِ ترنس‌ها بیشتر از سوژه‌های جنگ بها می‌دهد. بروید ویترین آثار جنشواره فیلم کوتاه تهران را ببینید. فمنیست‌ها، هواداران زن، زندگی، آزادی و حتی ضددین‌ها در آن سهم قابل توجهی از آثار را دارند. و سهمِ آثار مربوط به جنگ؟ فقط دو فیلم. آقای بهروز شعیبی! بالاخره «وطن» اولویت تولیدات شماست یا فقط موضوعی مناسبی برای برگزاری پویش‌های تشریفاتی است؟ چه بر سر انجمن سینمای جوان آوردید که در میانه جنگ، بیشتر از جنگ از ترنس‌ها حرف می‌زند و جمهوری اسلامی را روبروی خانواده شهید قرار می‌دهد؟! &lrm; ✅ @Tabnak","image":"https://cdn4.telesco.pe/file/R7DHBp0Essn4v9OUmpweK94DRTL_QZMhQy5qqWTmbLA9yGD0bWgFgzpS9xZ1jylPOMquMTdb_5kwQr8YuErEQhVHvFkVC_qnWvE51D4FzHBeVzCwZogp22qa2W6g1YVkZWgbLXcKJEgsUbaSDIYnUt61OZzjSvOQGIcWwa6ncA6-ye400EsiVB79qldW0dwEL2q4cCfJI8xATti0_-7JCbOhrGHl8AadHtyn3gjI973pgfufj2UuYqKkoGDVMQkgGvsHxE8hihSQ_7-TYzcQ3pPy5M9SqNpq9jr0sDVLN-ADrYvhdGQM9HPdFplQEt3sOIbr2WKiCk6sxzHUeOltHw.jpg","video":"","hasVideo":false},{"id":"247022","date":"2026-10-31T18:33:37+00:00","text":"&rlm; ✅ یدیعوت آحرونوت گزارش داد اداره اطلاعات نظامی و نیروی هوایی اسرائیل در حال تکمیل آمادگی‌های خود برای احتمال ازسرگیری درگیری با ایران هستند. این اقدامات در کنار تدارکات دفاعی صورت می‌گیرد. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247021","date":"2026-10-31T18:27:28+00:00","text":"&rlm; ✅ خطر وقوع سیلاب در خوزستان و لرستان با ورود سامانه بارشی جدید 📌 نقشه‌های هواشناسی از احتمال وقوع بارش‌های سنگین و سیل‌آسا در غرب و جنوب‌غرب ایران طی هفته آینده خبر می‌دهند. شمال خوزستان، لرستان و حوضه آبریز سد دز از حساس‌ترین نقاط در برابر این سامانه قدرتمند و پررطوبت هستند. 📌 شدت این بارندگی‌ها به میزان بارش در ترکیه و مسیر حرکت توده رطوبتی بستگی دارد. همچنین احتمال رسیدن یک موج رعدوبرقی از مرز عراق به خوزستان وجود دارد که پیش‌بینی می‌شود پیش از رسیدن به اهواز تضعیف شود. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247020","date":"2026-10-31T18:22:56+00:00","text":"&rlm; ✅ مطهری: مخالفان مذاکره باید راهکار ارائه دهند 📌 علی مطهری، فعال سیاسی، با انتقاد از مخالفان هرگونه مذاکره، خواستار ارائه راهکار از سوی آن‌ها شد و تأکید کرد مخالفت بدون راهکار منطقی نیست. او معتقد است شرایط بین‌المللی به سود ایران و به زیان آمریکاست و باید با دیپلماسی هوشمندانه، راهی برای خروج آبرومندانه از وضعیت فعلی پیدا کرد. &lrm; ✅ @Tabnak","image":"https://cdn4.telesco.pe/file/YowUocUVbWt9l2i5glrnfmiqlsdKeCAaZ5sGfQwAOCSacm9OgmWgW--l8c5xTDQrPfLK6X80GADs1pqo66NUhqVJAgwUyzAgH343oiF9we--HwD84_Ayc6gFGTX5Ev-t-6DfvsjLUkXwNcjQZcq-hszOxpa__Z7T_FmjbK8W8fmKK9kREe9epmmhGQRpmfd9-xhesWb0QNB8Pbw9xxJfj4pvB9NauXDyuGtnCOCC1OWTcqn2AV-AupwbzyebwlgtiRcfGPuKOL7majrobc_XtFbIh7GtoxbO8ibvLwI7qb1117EjcANcUU0UFcNHM-XdrBFV9Cg57loxdwNAxdjp9g.jpg","video":"","hasVideo":false},{"id":"247019","date":"2026-10-31T18:20:53+00:00","text":"&rlm; ✅ پروازها در فرودگاه الدمام عربستان مجدداً متوقف شد. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247018","date":"2026-10-31T18:14:35+00:00","text":"&rlm; ✅ ایران ابتدا رادارهای پایگاه‌های آمریکا را هدف قرار داد 📌 خبرگزاری آسوشیتدپرس گزارش داد ایران در حمله به بیش از ۲۶ پایگاه نظامی آمریکا در خاورمیانه، ابتدا سامانه‌های هشدار زودهنگام را برای کاهش توان شناسایی هدف گرفته است. بیشترین حملات در کویت رخ داده و پایگاه هوایی علی‌السالم دست‌کم ۳۰ بار هدف قرار گرفته که منجر به انهدام آشیانه‌ها، انبارها و ساختمان‌های این پایگاه شده است. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247017","date":"2026-10-31T18:13:07+00:00","text":"&rlm; ✅ وزیر خارجه سوریه اعلام کرد که موضوع پیوستن دمشق به پیمان دفاعی مکه در دست بررسی قرار دارد. &lrm; ✅ @Tabnak","image":"","video":"","hasVideo":false},{"id":"247016","date":"2026-10-31T18:00:12+00:00","text":"&rlm; ✅ تصویری از انفجار انجام شده توسط اسرائیل در جنوب لبنان منتشر شده است. &l